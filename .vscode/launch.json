{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Career Compass",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Career Compass (light mode, no AI models)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "CC_LIGHT_MODE": "1" }
    },
    {
      "name": "Run evaluation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Train fake job model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_fake_job.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
